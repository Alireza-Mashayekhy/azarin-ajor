generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users and Addresses
model User {
  id             Int        @id @default(autoincrement())
  email          String?    @unique
  phone          String?    @unique
  firstName      String?
  lastName       String?
  role           Role       @default(USER)
  addresses      Address[]
  mainAddressId  Int?       @unique
  mainAddress    Address?   @relation("UserMainAddress", fields: [mainAddressId], references: [id])
  cart           Cart?
  favorites      Favorite[]
  comments       Comment[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Address {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  label     String?
  country   String?
  province  String?
  city      String?
  street    String?
  postalCode String?
  // Back-reference for main address
  mainFor   User?   @relation("UserMainAddress")
}

// Products
model Product {
  id             Int                    @id @default(autoincrement())
  slug           String                 @unique
  price          Float
  imageUrl       String?
  size           String?
  widthMm        Int?
  heightMm       Int?
  thicknessMm    Int?
  unitsPerBox    Int?
  areaPerUnit    Float?                 // m² covered by one unit
  translations   ProductTranslation[]
  cartItems      CartItem[]
  favorites      Favorite[]
  comments       Comment[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model ProductTranslation {
  id          Int      @id @default(autoincrement())
  locale      String
  title       String
  description String
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([locale, productId])
}

// Blogs and Categories
model BlogPost {
  id           Int                      @id @default(autoincrement())
  slug         String                   @unique
  coverImage   String?
  categoryId   Int
  category     BlogCategory             @relation(fields: [categoryId], references: [id])
  publishedAt  DateTime?
  translations BlogPostTranslation[]
  favorites    Favorite[]
  comments     Comment[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model BlogPostTranslation {
  id              Int       @id @default(autoincrement())
  locale          String
  title           String
  excerpt         String?
  content         String
  metaTitle       String?
  metaDescription String?
  blogPostId      Int
  blogPost        BlogPost  @relation(fields: [blogPostId], references: [id])

  @@unique([locale, blogPostId])
}

model BlogCategory {
  id           Int                         @id @default(autoincrement())
  slug         String                      @unique
  translations BlogCategoryTranslation[]
  posts        BlogPost[]
}

model BlogCategoryTranslation {
  id          Int           @id @default(autoincrement())
  locale      String
  title       String
  categoryId  Int
  category    BlogCategory  @relation(fields: [categoryId], references: [id])

  @@unique([locale, categoryId])
}

// Cart
model Cart {
  id        Int         @id @default(autoincrement())
  userId    Int         @unique
  user      User        @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model CartItem {
  id         Int      @id @default(autoincrement())
  cartId     Int
  cart       Cart     @relation(fields: [cartId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Float?   // snapshot of price
}

// Favorites (for products and blogs)
model Favorite {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  productId  Int?
  product    Product?  @relation(fields: [productId], references: [id])
  blogPostId Int?
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id])
  createdAt  DateTime  @default(now())

  @@unique([userId, productId])
  @@unique([userId, blogPostId])
}

// Comments (for products and blogs)
model Comment {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  content    String
  rating     Int?
  productId  Int?
  product    Product?  @relation(fields: [productId], references: [id])
  blogPostId Int?
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([productId])
  @@index([blogPostId])
}

enum Role {
  USER
  ADMIN
}
